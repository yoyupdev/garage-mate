{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "noEmit": false,
        "rootDir": ".",
        "types": [
            "node",
            "jest"
        ]
    },
    "include": [
        "src/**/*.ts",
        "test/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}